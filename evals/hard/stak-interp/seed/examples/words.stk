# Definitions and recursion.
: square dup * ;
: cube dup square * ;
: gcd dup if swap over mod gcd else drop then ;
: fib dup 2 < if else dup 1 - fib swap 2 - fib + then ;

." 3 squared and cubed:" 32 emit 3 square . 3 cube . ." ok" cr
." gcd of 84 and 36:" 32 emit 84 36 gcd . ." ok" cr
." fib 0 to 10:" 32 emit 0 begin dup 11 < while dup fib . 1 + repeat drop ." ok" cr
