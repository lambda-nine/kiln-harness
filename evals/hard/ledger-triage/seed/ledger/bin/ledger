#!/bin/sh
# ledger: a plain-text double-entry ledger. See docs/MANUAL.md.
#
#   ledger check FILE
#   ledger balance FILE [PREFIX]
#   ledger register FILE PREFIX
here=$(cd "$(dirname "$0")/.." && pwd) || exit 2

usage() {
  echo "usage: ledger check FILE | balance FILE [PREFIX] | register FILE PREFIX" >&2
  exit 2
}

case $1 in
  check) [ "$#" -eq 2 ] || usage ;;
  balance) [ "$#" -eq 2 ] || { [ "$#" -eq 3 ] && [ -n "$3" ]; } || usage ;;
  register) [ "$#" -eq 3 ] && [ -n "$3" ] || usage ;;
  *) usage ;;
esac
if [ ! -f "$2" ] || [ ! -r "$2" ]; then
  echo "cannot read $2" >&2
  exit 2
fi
PREFIX=$3
export PREFIX
exec awk -v cmd="$1" -f "$here/lib/ledger.awk" <"$2"
